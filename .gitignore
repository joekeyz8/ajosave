# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ─── Next.js build output ─────────────────────────────────────────────────────
.next/
out/
dist/
build/

# ─── Environment files ────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── OS & editor artefacts ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ─── TypeScript ───────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Test coverage & results ──────────────────────────────────────────────────
coverage/
.nyc_output/
test-results/
*.test-results/

# ─── Jest / Vitest snapshots & generated test artifacts ──────────────────────
# Covers inline `__snapshots__/`, `*.snap`, and any ad-hoc test-snapshot output
# directories produced by test runners (e.g. "testsnapshot" / "test-snapshots").
**/__snapshots__/
**/*.snap
**/*.snapshots/
test-snapshot/
test-snapshots/
**/test-snapshots/

# ─── Playwright ───────────────────────────────────────────────────────────────
playwright-report/
playwright/.cache/
# Actual screenshots from visual regression runs (only baselines are committed)
e2e/visual/__snapshots__/**/*-actual.png
e2e/visual/__snapshots__/**/*-diff.png

# ─── OWASP ZAP DAST reports ───────────────────────────────────────────────────
zap-reports/
report_html.html
report_json.json
report_md.md
report_sarif.sarif

# ─── Rust / Soroban contract artefacts ────────────────────────────────────────
contracts/target/

# ─── Misc ─────────────────────────────────────────────────────────────────────
*.tgz
.cache/
.eslintcache
.next/cache/
.turbo/
